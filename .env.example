# ==============================================================================
# orgs-app-job-auto-rustwright - Multi-Provider Configuration Template
# ==============================================================================
# Copy this file to '.env' and configure your active provider:
# Choose one of: "gemini" | "huggingface" | "ollama_cloud" | "ollama_local"
LLM_PROVIDER="ollama_local"

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI (Google AI Studio)
# Free API key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 2. HUGGING FACE CLOUD (Serverless Inference)
# Free token with Read access: https://huggingface.co/settings/tokens
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY="hf_your_read_token"
HUGGINGFACE_MODEL="meta-llama/Llama-3.2-3B-Instruct"
HUGGINGFACE_BASE_URL="https://api-inference.huggingface.co/v1"

# ------------------------------------------------------------------------------
# 3. OLLAMA CLOUD (Remote hosted Ollama)
# ------------------------------------------------------------------------------
OLLAMA_CLOUD_URL="https://your-remote-ollama-host.com"
OLLAMA_CLOUD_API_KEY=""
OLLAMA_CLOUD_MODEL="llama3.2"

# ------------------------------------------------------------------------------
# 4. OLLAMA LOCAL (100% Free offline local LLM)
# Download from https://ollama.com and run: ollama run llama3.2
# ------------------------------------------------------------------------------
OLLAMA_LOCAL_URL="http://localhost:11434"
OLLAMA_LOCAL_MODEL="llama3.2"

# ------------------------------------------------------------------------------
# Browser & Runner Settings
# ------------------------------------------------------------------------------
HEADLESS="false"
BROWSER_TIMEOUT_MS=30000
MAX_STEPS_PER_JOB=30
AUTO_PAUSE_ON_AUTH="true"
AUTO_PAUSE_ON_EMPTY_FIELDS="true"
